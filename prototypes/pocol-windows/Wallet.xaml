<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PoCol Wallet" Width="1140" Height="820" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#060E18" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI" Foreground="#F4F8FB">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#1AA9E4"/><Setter Property="Foreground" Value="#052238"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="22,13"/><Setter Property="MinHeight" Value="46"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#91DEFF"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0C2233"/><Setter Property="Foreground" Value="#73D2FA"/><Setter Property="BorderBrush" Value="#214158"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#A1B1C3"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#060E18"/><Setter Property="Foreground" Value="#F4F8FB"/><Setter Property="CaretBrush" Value="#1AA9E4"/><Setter Property="SelectionBrush" Value="#167DA7"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,8,0,18"/><Setter Property="BorderBrush" Value="#213140"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="#1AA9E4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="BorderBrush" Value="#213140"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#0B1623"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="26"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#A1B1C3"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F8FB"/><Setter Property="Background" Value="#0C2233"/><Setter Property="BorderBrush" Value="#1AA9E4"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="ScrollBack" Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#32495C" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="ScrollForward" Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="ScrollBack" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="ScrollForward" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#09131F" BorderBrush="#213140" BorderThickness="0,0,1,0" Padding="22,28"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><Image x:Name="BrandLogo" Width="156" Height="45" Stretch="Uniform" HorizontalAlignment="Left" Margin="2,0,0,8" AutomationProperties.Name="PoCol"/><TextBlock Text="YOUR WALLET. YOUR NETWORK." FontSize="9" Foreground="#A1B1C3" Margin="4,0,0,30"/><TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#A1B1C3" Margin="16,0,0,10"/>
    <Button x:Name="NavWallet" AutomationProperties.Name="Wallet" Content="◈   Wallet" Style="{StaticResource Nav}"/><Button x:Name="NavActivity" AutomationProperties.Name="Activity" Content="≡   Activity" Style="{StaticResource Nav}"/><Button x:Name="NavMining" AutomationProperties.Name="Mining" Content="◇   Mining" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" AutomationProperties.Name="Settings" Content="⚙   Settings" Style="{StaticResource Nav}"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border Background="#0C2233" BorderBrush="#214158" BorderThickness="1" CornerRadius="14" Padding="14"><StackPanel><TextBlock x:Name="NetworkName" Text="●  PoCol network" FontSize="10" FontWeight="Bold" Foreground="#73D2FA"/><TextBlock Text="Your device. Your local validation." Style="{StaticResource Note}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="PoCol Wallet · 0.4.0&#10;Keys stay on this device" FontSize="11" Foreground="#A1B1C3" Margin="8,18,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,28,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock x:Name="PageTitle" Text="Wallet" FontSize="31" FontWeight="SemiBold"/><TextBlock x:Name="Connection" Text="Wallet offline" Style="{StaticResource Note}" FontSize="12" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" x:Name="Connect" Content="Connect wallet" Style="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <Grid>
     <StackPanel x:Name="WalletPage">
      <Border CornerRadius="22" Padding="28" Margin="0,0,0,18" BorderBrush="#20516C" BorderThickness="1" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0C2233" Offset="0"/><GradientStop Color="#0E354B" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Image x:Name="BalanceMark" Width="190" Height="190" Opacity="0.12" HorizontalAlignment="Right" Margin="0,-18,-12,-18" IsHitTestVisible="False"/><StackPanel><TextBlock Text="AVAILABLE BALANCE" Foreground="#A7C9DC" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="Balance" Text="—" Foreground="White" FontSize="48" FontWeight="SemiBold" Margin="0,13,0,0" TextWrapping="Wrap"/><TextBlock Text="PCOL · Native currency" FontSize="16" Foreground="#73D2FA" Margin="0,2,0,26"/><TextBlock Text="YOUR PUBLIC ADDRESS" Foreground="#A1B1C3" FontSize="9" Margin="0,0,0,6"/><TextBlock FontFamily="Consolas" x:Name="ShortAddress" Text="Creating your account…" Foreground="#BFDAE9" FontSize="13"/></StackPanel></Grid></Border>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Button x:Name="Send" Content="↗   Send PCOL"/><Button x:Name="Receive" Content="↙   Receive" Style="{StaticResource Secondary}"/></StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="YOUR ASSET" Foreground="#A1B1C3" FontSize="11" FontWeight="Bold"/><Grid Margin="0,20,0,0"><StackPanel Orientation="Horizontal"><Border Background="#0C2233" CornerRadius="16" Width="52" Height="52"><Image x:Name="AssetIcon" Width="34" Height="34" Stretch="Uniform"/></Border><StackPanel Margin="16,0,0,0"><TextBlock Text="PoCol" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Native asset · PCOL" Style="{StaticResource Note}"/></StackPanel></StackPanel><TextBlock Text="Local validation" Foreground="#A1B1C3" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connected, on your terms" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="WalletNote" Text="Connect to view your verified balance. Mining starts only when you enable it." Style="{StaticResource Note}" Margin="0,10,0,18"/><Button x:Name="ManageMining" Content="Manage mining  →" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="MiningPage" Visibility="Collapsed">
      <TextBlock Text="Contribute when it works for you." Style="{StaticResource Note}" Margin="0,0,0,20"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DEVICE MINING" Foreground="#A1B1C3" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Your work. Your choice." FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><CheckBox x:Name="MiningToggle" Content="Enable mining on this device" FontSize="18" Padding="12" Margin="0,20,0,12"/><TextBlock x:Name="MiningState" Text="Connect your wallet first." Style="{StaticResource Note}"/><TextBlock x:Name="Mined" Style="{StaticResource Note}" Margin="0,10,0,22"/><Button x:Name="Register" Content="Review mining registration" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="You stay in control" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Turning mining off keeps your wallet connected and validating. An eligible registered account is required to mine. Registration locks a bond and pays a network fee." Style="{StaticResource Note}" Margin="0,12,0,12"/><TextBlock Text="Mining uses processing power and electricity. Rewards depend on accepted work and are not guaranteed." Style="{StaticResource Note}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ActivityPage" Visibility="Collapsed"><TextBlock Text="Transactions submitted from this device" Style="{StaticResource Note}" Margin="0,0,0,18"/><StackPanel x:Name="ActivityList"/></StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Network" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Import the shared network file once. All devices must use the same network and release." Style="{StaticResource Note}" Margin="0,12,0,20"/><WrapPanel><Button x:Name="Import" Content="Import network file"/><Button x:Name="Upgrade" Content="Upgrade existing network" Style="{StaticResource Secondary}"/><Button x:Name="Disconnect" Content="Disconnect wallet" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock x:Name="Lifetime" Style="{StaticResource Note}" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your account" FontSize="22" FontWeight="SemiBold"/><TextBox x:Name="Address" FontFamily="Consolas" AutomationProperties.Name="Public wallet address" IsReadOnly="True" FontSize="13"/><Button x:Name="CopyAddress" Content="Copy public address" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/><TextBlock Text="Your encrypted key is tied to your Windows user. Keep a suitable Windows profile backup. A portable recovery export is not available in this build." Style="{StaticResource Note}" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock x:Name="Message" Grid.Row="2" Text="" Style="{StaticResource Note}" FontSize="12" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
