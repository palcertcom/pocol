<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PoCol Wallet" Width="1140" Height="820" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F5F8FC" FontFamily="Segoe UI" Foreground="#112639">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#1AA9E4"/><Setter Property="Foreground" Value="#112639"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="22,14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E5F5FC"/><Setter Property="Foreground" Value="#08779F"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64778A"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,8,0,18"/><Setter Property="BorderBrush" Value="#CDDAE5"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="26"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#64778A"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="White" Padding="24,28"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="◈  PoCol" FontSize="28" FontWeight="Bold" Margin="4,0,0,8"/><TextBlock Text="YOUR WALLET. YOUR NETWORK." FontSize="9" Foreground="#64778A" Margin="4,0,0,40"/>
    <Button x:Name="NavWallet" Content="◈   Wallet" Style="{StaticResource Nav}"/><Button x:Name="NavActivity" Content="≡   Activity" Style="{StaticResource Nav}"/><Button x:Name="NavMining" Content="◇   Mining" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="⚙   Settings" Style="{StaticResource Nav}"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border Background="#E5F5FC" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="TEST NETWORK" FontSize="10" FontWeight="Bold" Foreground="#08779F"/><TextBlock Text="PCOL test coins have no market price." Style="{StaticResource Note}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="Keys stay on this device" FontSize="11" Foreground="#64778A" Margin="8,18,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><StackPanel><TextBlock x:Name="PageTitle" Text="Wallet" FontSize="31" FontWeight="SemiBold"/><TextBlock x:Name="Connection" Text="Wallet offline" Style="{StaticResource Note}" Margin="0,7,0,0"/></StackPanel><Button x:Name="Connect" Content="Connect wallet" Style="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <Grid>
     <StackPanel x:Name="WalletPage">
      <Border CornerRadius="26" Padding="30" Margin="0,0,0,20"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#112639" Offset="0"/><GradientStop Color="#0D415E" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Ellipse Width="210" Height="210" Fill="#1127B6EF" HorizontalAlignment="Right" Margin="0,-18,-18,-18"/><StackPanel><TextBlock Text="AVAILABLE BALANCE" Foreground="#A7C9DC" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="Balance" Text="—" Foreground="White" FontSize="48" FontWeight="SemiBold" Margin="0,13,0,0" TextWrapping="Wrap"/><TextBlock Text="PCOL · Test currency" FontSize="16" Foreground="#7FDBFF" Margin="0,2,0,26"/><TextBlock x:Name="ShortAddress" Text="Creating your account…" Foreground="#BFDAE9" FontSize="13"/></StackPanel></Grid></Border>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Button x:Name="Send" Content="↗   Send PCOL"/><Button x:Name="Receive" Content="↙   Receive" Style="{StaticResource Secondary}"/></StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="YOUR ASSET" Foreground="#64778A" FontSize="11" FontWeight="Bold"/><Grid Margin="0,20,0,0"><StackPanel Orientation="Horizontal"><Border Background="#E5F5FC" CornerRadius="16" Width="52" Height="52"><TextBlock Text="◈" Foreground="#08779F" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="16,0,0,0"><TextBlock Text="PoCol" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Native asset · PCOL" Style="{StaticResource Note}"/></StackPanel></StackPanel><TextBlock Text="Verified locally" Foreground="#64778A" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connected, on your terms" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="WalletNote" Text="Connect to view your verified balance. Mining starts only when you enable it." Style="{StaticResource Note}" Margin="0,10,0,18"/><Button x:Name="ManageMining" Content="Manage mining  →" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="MiningPage" Visibility="Collapsed">
      <TextBlock Text="Contribute when it works for you." Style="{StaticResource Note}" Margin="0,0,0,20"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Device mining" FontSize="22" FontWeight="SemiBold"/><CheckBox x:Name="MiningToggle" Content="Enable mining on this device" FontSize="18" Padding="12" Margin="0,20,0,12"/><TextBlock x:Name="MiningState" Text="Connect your wallet first." Style="{StaticResource Note}"/><TextBlock x:Name="Mined" Style="{StaticResource Note}" Margin="0,10,0,22"/><Button x:Name="Register" Content="Review mining registration" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="You stay in control" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Turning mining off keeps your wallet connected and validating. An eligible registered account is required to mine. Registration locks a bond and pays a network fee." Style="{StaticResource Note}" Margin="0,12,0,12"/><TextBlock Text="Mining uses processing power and electricity. Rewards depend on accepted work and are not guaranteed." Style="{StaticResource Note}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ActivityPage" Visibility="Collapsed"><TextBlock Text="Transactions submitted from this device" Style="{StaticResource Note}" Margin="0,0,0,18"/><StackPanel x:Name="ActivityList"/></StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Network" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Import the shared network file once. All devices must use the same network and release." Style="{StaticResource Note}" Margin="0,12,0,20"/><StackPanel Orientation="Horizontal"><Button x:Name="Import" Content="Import network file"/><Button x:Name="Disconnect" Content="Disconnect wallet" Style="{StaticResource Secondary}"/></StackPanel><TextBlock x:Name="Lifetime" Style="{StaticResource Note}" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your account" FontSize="22" FontWeight="SemiBold"/><TextBox x:Name="Address" IsReadOnly="True" FontSize="13"/><Button x:Name="CopyAddress" Content="Copy public address" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/><TextBlock Text="Your encrypted key is tied to your Windows user. Keep a suitable Windows profile backup. A portable recovery export is not available in this test build." Style="{StaticResource Note}" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock x:Name="Message" Grid.Row="2" Text="" Style="{StaticResource Note}" FontSize="12" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
