{
  "name": "pocol-extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "PoCol Studio, IDE contract wallet and verified on-chain viewer",
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/unit.mjs",
    "test:studio": "node tests/studio_test.mjs",
    "test:publisher": "node --test tests/publisher_test.mjs",
    "test:contracts": "node --test tests/contracts_test.mjs",
    "test:contract-ui": "node --test tests/contract_ui_test.mjs",
    "package": "node build.mjs && python3 scripts/package-release.py"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.3.0",
    "ethers": "6.17.0"
  }
}
