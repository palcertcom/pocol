              "relationships": [],
              "shortDescription": {
                "markdown": "RUSTSEC-2026-0012: Unsoundness in opt-in ARMv8 assembly backend for `keccak`",
                "text": "RUSTSEC-2026-0012: Unsoundness in opt-in ARMv8 assembly backend for `keccak`"
