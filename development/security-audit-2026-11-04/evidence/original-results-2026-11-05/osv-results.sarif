              "shortDescription": {
                "markdown": "CVE-2025-54798: tmp allows arbitrary temporary file / directory write via symbolic link `dir` parameter",
                "text": "CVE-2025-54798: tmp allows arbitrary temporary file / directory write via symbolic link `dir` parameter"
